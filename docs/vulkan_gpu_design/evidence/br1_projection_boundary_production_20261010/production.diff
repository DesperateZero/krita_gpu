+    // effect, but never replay the failed compositor (or fall back to legacy).
+    d->device->clear(clearRect);
+    KisStrokeJobFailureContext::reportFailure(error.isEmpty()
+        ? QStringLiteral("Painter pixel operation failed") : error);
+}
